# ==============================================================================
# Factory-Management v1 Environment Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
#
# SECURITY WARNING:
# .env is git-ignored and MUST NEVER be committed or pushed to source control.
# ==============================================================================

# Supabase PostgreSQL (Pooled - Port 6543 for app queries / transaction mode)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL (Direct - Port 5432 session mode for Prisma migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Application Config
SESSION_SECRET="your-secure-random-session-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
