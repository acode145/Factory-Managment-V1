generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  fullName         String
  username         String            @unique
  password         String            // Stored visible/plain-accessible per admin requirement
  role             String            @default("STOREKEEPER") // ADMIN, STOREKEEPER, FLOOR_SUPERVISOR, GATE_CLERK, FABRIC_PROCESSING_INCHARGE
  department       String?           // STORE, EMBROIDERY, CROPPING, CUTTING, FINISHING, PACKAGING
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  inwardsCreated    FabricInward[]   @relation("UserInwards")
  dispatchesCreated DeliveryChallan[] @relation("UserDispatches")
  outsourceSent     OutsourceBatch[] @relation("SentByUser")
  outsourceReceived OutsourceBatch[] @relation("ReceivedByUser")
  outsourceReturns  OutsourceBatchReturn[] @relation("ReturnReceivedByUser")
  transfersMade     DepartmentTransfer[]   @relation("UserTransfers")
  transfersAccepted DepartmentTransfer[]   @relation("TransferAcceptor")
}

model Party {
  id               String            @id @default(uuid())
  code             String            @unique // e.g. PRT-001
  name             String
  partyType        String            @default("REGULAR_CLIENT") // REGULAR_CLIENT, STOCKING_CONSIGNMENT, IN_HOUSE_LABEL
  contactPerson    String?
  phone            String?
  address          String?
  notes            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  inwards          FabricInward[]
  deliveries       DeliveryChallan[]
  outsourceBatches OutsourceBatch[]
  ledgerEntries    FabricLedgerEntry[]
  departmentTransfers DepartmentTransfer[]
}

model Vendor {
  id               String            @id @default(uuid())
  code             String            @unique // e.g. VND-001
  name             String
  defaultProcess   String            @default("SOLID_DYEING") // SOLID_DYEING, ROTARY_PRINTING, DIGITAL_PRINTING, WASHING
  contactPerson    String?
  phone            String?
  address          String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())

  outsourceBatches OutsourceBatch[]
}

model FabricInward {
  id               String            @id @default(uuid())
  igpNumber        String            @unique // IGP-2026-XXXX
  partyId          String
  party            Party             @relation(fields: [partyId], references: [id])
  partyChallanNo   String
  fabricType       String?           // Cached or primary item fabric type
  colorShade       String?           // Cached or primary item color
  rollCount        Int               @default(0)
  challanMeters    Decimal           @default(0) @db.Decimal(10, 2)
  measuredMeters   Decimal           @default(0) @db.Decimal(10, 2)
  shortageMeters   Decimal           @default(0) @db.Decimal(10, 2)
  driverDetails    String?
  remarks          String?
  receivedById     String
  receivedBy       User              @relation("UserInwards", fields: [receivedById], references: [id])
  challanDate      DateTime          @default(now())
  editHistory      Json?             @default("[]")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?         @updatedAt

  items            FabricInwardItem[]
  outsourceBatches OutsourceBatch[]
  deliveries       DeliveryChallanItem[]
  ledgerEntries    FabricLedgerEntry[]
  transfers        DepartmentTransfer[]
}

model FabricInwardItem {
  id               String            @id @default(uuid())
  inwardId         String
  inward           FabricInward      @relation(fields: [inwardId], references: [id], onDelete: Cascade)
  itemIndex        Int               @default(0)
  fabricType       String            // e.g. Lawn 68/68, Cambric, Khaddar Sleeves
  colorShade       String            // e.g. Greige/Raw, Bleach White, Brown
  unit             String            @default("METERS") // METERS, YARDS, PIECES
  rollCount        Int               @default(1)
  challanQty       Decimal           @db.Decimal(10, 2)
  measuredQty      Decimal           @db.Decimal(10, 2)
  shortageQty      Decimal           @default(0) @db.Decimal(10, 2)
  standardMeters   Decimal?          @db.Decimal(10, 2) // Canonical standard meters for continuous fabric
  createdAt        DateTime          @default(now())

  ledgerEntries    FabricLedgerEntry[]
  outsourceBatches OutsourceBatch[]
  transfers        DepartmentTransfer[]
}

model OutsourceBatch {
  id               String            @id @default(uuid())
  ogpNumber        String            // OGP-2026-XXXX (Can be shared across multiple items in same dispatch)
  partyId          String
  party            Party             @relation(fields: [partyId], references: [id])
  vendorId         String
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  inwardId         String?
  inward           FabricInward?     @relation(fields: [inwardId], references: [id])
  inwardItemId     String?
  inwardItem       FabricInwardItem? @relation(fields: [inwardItemId], references: [id])
  unit             String            @default("METERS") // METERS, YARDS, PIECES
  itemCategory     String            @default("CONTINUOUS") // CONTINUOUS, PIECES
  processType      String            @default("SOLID_DYEING")
  targetShade      String
  sentMeters       Decimal           @db.Decimal(10, 2)
  sentDate         DateTime          @default(now())
  sentById         String
  sentBy           User              @relation("SentByUser", fields: [sentById], references: [id])

  status           String            @default("WITH_VENDOR") // WITH_VENDOR, RECEIVED_COMPLETE, RECEIVED_PARTIAL
  accountedMeters  Decimal           @default(0) @db.Decimal(10, 2) // Sum of sentMeters cleared by returns
  vendorChallanNo  String?
  receivedMeters   Decimal?          @db.Decimal(10, 2)
  shrinkageMeters  Decimal?          @db.Decimal(10, 2)
  shrinkagePercent Decimal?          @db.Decimal(5, 2)
  receivedDate     DateTime?
  receivedById     String?
  receivedBy       User?             @relation("ReceivedByUser", fields: [receivedById], references: [id])
  remarks          String?
  editHistory      Json?             @default("[]")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?         @updatedAt

  returns          OutsourceBatchReturn[]

  @@index([ogpNumber])
}

model OutsourceBatchReturn {
  id               String            @id @default(uuid())
  batchId          String
  batch            OutsourceBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  vendorChallanNo  String
  unit             String            @default("METERS")
  accountedMeters  Decimal           @db.Decimal(10, 2) // Portion of sent meters cleared
  receivedMeters   Decimal           @db.Decimal(10, 2) // Physical meters received
  shrinkageMeters  Decimal           @db.Decimal(10, 2)
  shrinkagePercent Decimal           @db.Decimal(5, 2)
  returnDate       DateTime          @default(now())
  receivedById     String
  receivedBy       User              @relation("ReturnReceivedByUser", fields: [receivedById], references: [id])
  remarks          String?
  createdAt        DateTime          @default(now())
}

model DeliveryChallan {
  id               String            @id @default(uuid())
  challanNumber    String            @unique // DC-2026-XXXX
  partyId          String
  party            Party             @relation(fields: [partyId], references: [id])
  dispatchDate     DateTime          @default(now())
  totalMeters      Decimal           @db.Decimal(10, 2)
  totalRolls       Int
  vehicleDriver    String?
  dispatchedById   String
  dispatchedBy     User              @relation("UserDispatches", fields: [dispatchedById], references: [id])
  remarks          String?
  editHistory      Json?             @default("[]")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?         @updatedAt

  items            DeliveryChallanItem[]
}

model DeliveryChallanItem {
  id               String            @id @default(uuid())
  challanId        String
  challan          DeliveryChallan   @relation(fields: [challanId], references: [id], onDelete: Cascade)
  inwardId         String?
  inward           FabricInward?     @relation(fields: [inwardId], references: [id])
  fabricType       String
  colorShade       String
  metersDelivered  Decimal           @db.Decimal(10, 2)
  rollsDelivered   Int
}

model FabricLedgerEntry {
  id               String            @id @default(uuid())
  partyId          String
  party            Party             @relation(fields: [partyId], references: [id])
  partyChallanNo   String?           // Originating Party Inward Challan / Bilty # (e.g. CH-0002)
  inwardId         String?
  inward           FabricInward?     @relation(fields: [inwardId], references: [id])
  inwardItemId     String?
  inwardItem       FabricInwardItem? @relation(fields: [inwardItemId], references: [id])

  itemCategory     String            @default("CONTINUOUS") // CONTINUOUS (m/yd) vs PIECES (pcs)
  fabricDescription String?          // e.g. "Lawn 68/68 (Greige)" or "Khaddar Sleeves (Brown)"
  unit             String            @default("METERS") // METERS, YARDS, PIECES

  movementType     String            // PARTY_INWARD, INWARD_SHORTAGE, OUTWARD_TO_VENDOR, INWARD_FROM_VENDOR, DELIVERY_TO_PARTY, ADJUSTMENT
  referenceNumber  String            // IGP, OGP, or DC number

  // For CONTINUOUS fabric (Meters):
  creditMeters     Decimal           @default(0) @db.Decimal(10, 2)
  debitMeters      Decimal           @default(0) @db.Decimal(10, 2)
  shrinkageMeters  Decimal           @default(0) @db.Decimal(10, 2)
  runningBalance   Decimal           @default(0) @db.Decimal(10, 2)

  // For PIECES fabric (Pcs):
  creditPieces     Int               @default(0)
  debitPieces      Int               @default(0)
  shortagePieces   Int               @default(0)
  runningPieces    Int               @default(0)

  timestamp        DateTime          @default(now())
  notes            String?
  createdAt        DateTime          @default(now())

  @@index([partyId])
  @@index([partyChallanNo])
  @@index([itemCategory])
}

model DepartmentTransfer {
  id                String            @id @default(uuid())
  transferNumber    String            @unique // TRF-2026-XXXX
  partyId           String
  party             Party             @relation(fields: [partyId], references: [id])
  inwardId          String?
  inward            FabricInward?     @relation(fields: [inwardId], references: [id])
  inwardItemId      String?
  inwardItem        FabricInwardItem? @relation(fields: [inwardItemId], references: [id])

  fabricDescription String            // e.g. "Lawn 68/68 (Jet Black)"
  unit              String            @default("METERS") // METERS, YARDS, PIECES
  quantity          Decimal           @db.Decimal(10, 2)
  damagedQuantity   Decimal           @default(0) @db.Decimal(10, 2)

  fromDepartment    String            // STORE, EMBROIDERY, CROPPING, CUTTING, FINISHING, PACKAGING
  toDepartment      String            // STORE, EMBROIDERY, CROPPING, CUTTING, FINISHING, PACKAGING
  machineNumber     String?           // e.g. "Machine #04"
  operatorName      String?           // Operator / Supervisor name
  remarks           String?

  transferredById   String
  transferredBy     User              @relation("UserTransfers", fields: [transferredById], references: [id])

  status            String            @default("ACCEPTED") // PENDING, ACCEPTED, REJECTED
  acceptedById      String?
  acceptedBy        User?             @relation("TransferAcceptor", fields: [acceptedById], references: [id])
  acceptedAt        DateTime?
  rejectionReason   String?

  transferDate      DateTime          @default(now())
  createdAt         DateTime          @default(now())

  @@index([partyId])
  @@index([fromDepartment])
  @@index([toDepartment])
  @@index([inwardItemId])
  @@index([status])
}